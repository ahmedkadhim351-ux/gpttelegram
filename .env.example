# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: custom OpenAI base URL (e.g. for proxy or compatible API)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: comma-separated list of allowed Telegram user IDs.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Default chat model
DEFAULT_MODEL=gpt-4o-mini

# Default image generation model: dall-e-3 or dall-e-2
DEFAULT_IMAGE_MODEL=dall-e-3

# Voice transcription model
WHISPER_MODEL=whisper-1

# How many last messages of dialogue history to keep per user
HISTORY_LIMIT=20

# System prompt sent at the start of every conversation
SYSTEM_PROMPT=You are a helpful AI assistant integrated into a Telegram bot. Be concise, friendly, and helpful. Use Markdown formatting when appropriate.
