# Telegram Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Optional: maximum file size to send back, in MiB (Telegram bot limit is 50).
MAX_FILE_SIZE_MB=50

# Optional: cap downloaded video height (e.g. 720, 480).
MAX_VIDEO_HEIGHT=720

# Optional: path to a Netscape-format cookies file used by yt-dlp.
# Useful for sites that require login (Instagram, some YouTube videos, etc.)
COOKIES_FILE=

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO
