# --- Telegram bot ---
# Token from @BotFather (used by the main GPT Telegram bot, not by tiktok_autopost).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- tiktok_autopost ---
# Create a TikTok app at https://developers.tiktok.com and apply for the
# "Content Posting API" with the `video.publish` scope.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered for your TikTok app.
TIKTOK_REDIRECT_URI=https://example.com/oauth/tiktok/callback
# Filled in after you complete the OAuth flow (see tiktok_autopost/README.md).
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
